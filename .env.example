# Copy to .env.local for local dev.
#
# Vercel (Production + Preview): Project → Settings → Environment Variables
# Add each key below; redeploy after changing secrets. No secrets belong in git.

# Redshift (heatmap /api/deals and related data)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=

# HubSpot (campaign dashboard API)
HUBSPOT_ACCESS_TOKEN=

# Optional: HubSpot portal ID for company-record links on the map (defaults to 49044619)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# Set to false to skip ~8k lead company records (no qualifying deal) on /api/deals
INCLUDE_LEAD_COMPANIES=

# Set to true to load all company-only HubSpot rows (slow; ~9k rows)
INCLUDE_COMPANY_ONLY_RECORDS=

# Cron: /api/cron/geocode — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
