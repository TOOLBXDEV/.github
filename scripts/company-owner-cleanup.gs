const KEEP_OWNER_STAGES = ['customer', '1050035315', '1050035316', 'opportunity'];

function setupSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('Company Owner Cleanup');
  if (sheet) ss.deleteSheet(sheet);
  sheet = ss.insertSheet('Company Owner Cleanup');

  const headers = [
    'Company ID', 'Company Name', 'HubSpot Link', 'Lifecycle Stage',
    'Company Owner', 'AE Territory', 'SDR',
    'Postal Code', 'State', 'State Code', 'Country',
    'Buying Group', 'Buying Group Name',
    'Recommended Action', 'Execute? (YES)'
  ];
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#4285f4').setFontColor('white');
  sheet.setFrozenRows(1);

  Logger.log('Fetching label mappings...');
  const lifecycleMap = getLifecycleStageMap_();
  const ownerMap = getOwnerMap_();
  Logger.log('Loaded ' + Object.keys(lifecycleMap).length + ' lifecycle stages, ' + Object.keys(ownerMap).length + ' owners');

  Logger.log('Fetching ' + COMPANY_IDS.length + ' companies...');
  const allCompanies = [];
  for (let i = 0; i < COMPANY_IDS.length; i += BATCH_SIZE) {
    const batch = COMPANY_IDS.slice(i, i + BATCH_SIZE);
    Logger.log('Batch ' + (Math.floor(i / BATCH_SIZE) + 1) + ' of ' + Math.ceil(COMPANY_IDS.length / BATCH_SIZE));
    allCompanies.push(...fetchCompaniesBatch_(batch));
    if (i + BATCH_SIZE < COMPANY_IDS.length) Utilities.sleep(200);
  }
  Logger.log('Fetched ' + allCompanies.length + ' companies');

  const buyingGroupIds = [...new Set(
    allCompanies.map(c => c.reference_company).filter(Boolean)
  )];
  const buyingGroupMap = fetchCompanyNames_(buyingGroupIds);
  Logger.log('Resolved ' + Object.keys(buyingGroupMap).length + ' buying group names');

  const rows = allCompanies.map(c => {
    const stageValue = c.lifecyclestage || '';
    const stageLabel = lifecycleMap[stageValue] || stageValue || '';
    const ownerLabel = ownerMap[c.hubspot_owner_id || ''] || '';
    const aeLabel = ownerMap[c.ae_territory || ''] || '';
    const sdrLabel = ownerMap[c.sdr || ''] || '';
    const bgId = c.reference_company || '';
    const bgFlag = bgId ? 'YES' : 'NO';
    const bgName = buyingGroupMap[bgId] || '';
    const shouldClear = !KEEP_OWNER_STAGES.includes(stageValue);

    return [
      c.hs_object_id,
      c.name || '',
      'https://app.hubspot.com/contacts/' + PORTAL_ID + '/record/0-2/' + c.hs_object_id,
      stageLabel,
      ownerLabel,
      aeLabel,
      sdrLabel,
      c.zip || '',
      c.state || '',
      c.hs_state_code || '',
      c.country || '',
      bgFlag,
      bgName,
      shouldClear ? 'CLEAR OWNER' : 'KEEP OWNER',
      ''
    ];
  });

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);

    rows.forEach(function(row, idx) {
      var cell = sheet.getRange(idx + 2, 14);
      if (row[13] === 'CLEAR OWNER') {
        cell.setBackground('#fce8e6').setFontColor('#c53929');
      } else {
        cell.setBackground('#e6f4ea').setFontColor('#137333');
      }
    });

    sheet.autoResizeColumns(1, headers.length);
  }

  var clearCount = rows.filter(function(r) { return r[13] === 'CLEAR OWNER'; }).length;
  var keepCount = rows.filter(function(r) { return r[13] === 'KEEP OWNER'; }).length;
  sheet.getRange(1, 17).setValue('Summary').setFontWeight('bold');
  sheet.getRange(2, 17).setValue('Total:');    sheet.getRange(2, 18).setValue(rows.length);
  sheet.getRange(3, 17).setValue('Clear:');    sheet.getRange(3, 18).setValue(clearCount);
  sheet.getRange(4, 17).setValue('Keep:');     sheet.getRange(4, 18).setValue(keepCount);

  SpreadsheetApp.getUi().alert(
    'Setup complete!\n\n' + rows.length + ' companies analyzed:\n' +
    '- ' + clearCount + ' flagged to CLEAR OWNER\n' +
    '- ' + keepCount + ' flagged to KEEP OWNER\n\n' +
    'Enter YES in column O for rows you want to execute.'
  );
}

function executeCleanup() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Company Owner Cleanup');
  if (!sheet) { SpreadsheetApp.getUi().alert('Run setupSheet() first.'); return; }

  var data = sheet.getDataRange().getValues();
  var execCol = data[0].indexOf('Execute? (YES)');
  var idCol = data[0].indexOf('Company ID');
  var recCol = data[0].indexOf('Recommended Action');
  if (execCol === -1 || idCol === -1) { SpreadsheetApp.getUi().alert('Required columns not found.'); return; }

  var toUpdate = [];
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][execCol]).toUpperCase() === 'YES' && data[i][recCol] === 'CLEAR OWNER') {
      toUpdate.push({ id: data[i][idCol], row: i + 1 });
    }
  }
  if (toUpdate.length === 0) { SpreadsheetApp.getUi().alert('No rows marked YES.'); return; }

  var confirm = SpreadsheetApp.getUi().alert(
    'Confirm', 'Clear company owner for ' + toUpdate.length + ' companies?',
    SpreadsheetApp.getUi().ButtonSet.YES_NO
  );
  if (confirm !== SpreadsheetApp.getUi().Button.YES) return;

  var ok = 0, fail = 0;
  for (var i = 0; i < toUpdate.length; i += BATCH_SIZE) {
    var batch = toUpdate.slice(i, i + BATCH_SIZE);
    var result = clearOwnersBatch_(batch.map(function(r) { return r.id; }));
    ok += result.success;
    fail += result.errors;
    batch.forEach(function(r) { sheet.getRange(r.row, execCol + 1).setValue('DONE'); });
    if (i + BATCH_SIZE < toUpdate.length) Utilities.sleep(200);
  }

  SpreadsheetApp.getUi().alert('Complete: ' + ok + ' cleared, ' + fail + ' errors.');
}

// ── Private helpers ──

function getLifecycleStageMap_() {
  var res = UrlFetchApp.fetch(
    'https://api.hubapi.com/crm/v3/properties/companies/lifecyclestage',
    { headers: { 'Authorization': 'Bearer ' + HUBSPOT_API_KEY } }
  );
  var map = {};
  JSON.parse(res.getContentText()).options.forEach(function(o) { map[o.value] = o.label; });
  return map;
}

function getOwnerMap_() {
  var map = {};
  var after = '';
  while (true) {
    var url = 'https://api.hubapi.com/crm/v3/owners?limit=100' + (after ? '&after=' + after : '');
    var res = UrlFetchApp.fetch(url, { headers: { 'Authorization': 'Bearer ' + HUBSPOT_API_KEY } });
    var data = JSON.parse(res.getContentText());
    (data.results || []).forEach(function(o) {
      map[o.id] = [o.firstName, o.lastName].filter(Boolean).join(' ') || o.email || '';
    });
    if (data.paging && data.paging.next && data.paging.next.after) {
      after = data.paging.next.after;
    } else {
      break;
    }
  }
  return map;
}

function fetchCompaniesBatch_(ids) {
  var res = UrlFetchApp.fetch('https://api.hubapi.com/crm/v3/objects/companies/batch/read', {
    method: 'post',
    contentType: 'application/json',
    headers: { 'Authorization': 'Bearer ' + HUBSPOT_API_KEY },
    payload: JSON.stringify({
      properties: [
        'name', 'lifecyclestage', 'hubspot_owner_id', 'ae_territory', 'sdr',
        'reference_company', 'zip', 'state', 'hs_state_code', 'country', 'hs_object_id'
      ],
      inputs: ids.map(function(id) { return { id: String(id) }; })
    }),
    muteHttpExceptions: true
  });
  var data = JSON.parse(res.getContentText());
  return (data.results || []).map(function(c) { return c.properties; });
}

function fetchCompanyNames_(ids) {
  var map = {};
  if (!ids.length) return map;
  for (var i = 0; i < ids.length; i += BATCH_SIZE) {
    var batch = ids.slice(i, i + BATCH_SIZE);
    var res = UrlFetchApp.fetch('https://api.hubapi.com/crm/v3/objects/companies/batch/read', {
      method: 'post',
      contentType: 'application/json',
      headers: { 'Authorization': 'Bearer ' + HUBSPOT_API_KEY },
      payload: JSON.stringify({
        properties: ['name'],
        inputs: batch.map(function(id) { return { id: String(id) }; })
      }),
      muteHttpExceptions: true
    });
    var data = JSON.parse(res.getContentText());
    (data.results || []).forEach(function(c) { map[c.id] = c.properties.name || ''; });
    if (i + BATCH_SIZE < ids.length) Utilities.sleep(200);
  }
  return map;
}

function clearOwnersBatch_(ids) {
  try {
    var res = UrlFetchApp.fetch('https://api.hubapi.com/crm/v3/objects/companies/batch/update', {
      method: 'post',
      contentType: 'application/json',
      headers: { 'Authorization': 'Bearer ' + HUBSPOT_API_KEY },
      payload: JSON.stringify({
        inputs: ids.map(function(id) { return { id: String(id), properties: { hubspot_owner_id: '' } }; })
      }),
      muteHttpExceptions: true
    });
    var data = JSON.parse(res.getContentText());
    if (res.getResponseCode() === 200 && data.results) {
      return { success: data.results.length, errors: 0 };
    }
    Logger.log('Batch error: ' + res.getContentText());
    return { success: 0, errors: ids.length };
  } catch (e) {
    Logger.log('Exception: ' + e);
    return { success: 0, errors: ids.length };
  }
}
